[
    {
        "start": 80.60909375,
        "end": 83.93346875,
        "name": "루피",
        "text": "잠깐 오빠, 그렇게 힘주면 안 돼.",
        "corrected_text": "잠깐, 오빠. 그렇게 힘주면 안 돼."
    },
    {
        "start": 84.45659375000001,
        "end": 87.15659375,
        "name": "루피",
        "text": "좋아, 그렇게 더 부드럽게.",
        "corrected_text": "좋아, 그렇게 더 부드럽게."
    },
    {
        "start": 88.54034375,
        "end": 92.45534375,
        "name": "루피",
        "text": "다리는 조금만 더 벌리고, 허리는 살짝만 풀어봐.",
        "corrected_text": "다리는 조금만 더 벌리고, 허리는 살짝만 풀어봐."
    },
    {
        "start": 92.59034375,
        "end": 95.18909375,
        "name": "루피",
        "text": "나머지는 내가 알아서 할게.",
        "corrected_text": "나머지는 내가 알아서 할게."
    },
    {
        "start": 99.25596875,
        "end": 99.96471875,
        "name": "도라",
        "text": "루피,",
        "corrected_text": "루피,"
    },
    {
        "start": 101.14596875,
        "end": 102.56346875,
        "name": "도라",
        "text": "그냥 사이즈만 잰다며.",
        "corrected_text": "그냥 사이즈만 잰다며."
    },
    {
        "start": 102.83346875,
        "end": 103.57596875,
        "name": "도라",
        "text": "얼른어나",
        "corrected_text": "얼른 해."
    },
    {
        "start": 108.52034375,
        "end": 113.36346875,
        "name": "루피",
        "text": "오빠가 가만히 있질 않는걸 그리고 사이즈 재는 건 네가 부탁한 거잖아",
        "corrected_text": "오빠가 가만히 있질 않는걸. 그리고 사이즈 재는 건 네가 부탁한 거잖아."
    },
    {
        "start": 113.76846875,
        "end": 117.97034375,
        "name": "루피",
        "text": "같이 만찬에 가야 한다며 그럼 맞춤 정장이 필요할 테고 그래서 내가",
        "corrected_text": "같이 만찬에 가야 한다며. 그럼 맞춤 정장이 필요할 테고, 그래서 내가…"
    },
    {
        "start": 117.97034375,
        "end": 122.29034375,
        "name": "도라",
        "text": "말했었지 그냥 적당히 괜찮은 수트 하나만 골라달라고",
        "corrected_text": "말했었지. 그냥 적당히 괜찮은 수트 하나만 골라 달라고."
    },
    {
        "start": 122.64471875,
        "end": 127.94346875,
        "name": "도라",
        "text": "왜 맞춤 제작까지 하려는? 비효율적이야. 가성비란 말이 괜히 있는 게 아니라고.",
        "corrected_text": "왜 맞춤 제작까지 하려는 거야? 비효율적이야. 가성비란 말이 괜히 있는 게 아니라고."
    },
    {
        "start": 128.58471875,
        "end": 146.26971875,
        "name": "루피",
        "text": "오빠, 어떻게 생각해? 난 오빠를 위해서 우리 가게도 통째로 비우고 이렇게 직접 사이즈를 재주로 온 건데. 게다가 온 매장을 다 뒤져서 제일 좋은 원단만 싹 모아왔단 말이야. 그런데 저렇게 이야기하는 건 좀 너무하지 않아? 내 정성을 무시하는 발언이라고.",
        "corrected_text": "오빠, 어떻게 생각해? 난 오빠를 위해서 우리 가게도 통째로 비우고 이렇게 직접 사이즈를 재러 온 건데. 게다가 온 매장을 다 뒤져서 제일 좋은 원단만 싹 모아왔단 말이야. 그런데 저렇게 이야기하는 건 좀 너무하지 않아? 내 정성을 무시하는 발언이라고."
    },
    {
        "start": 149.13846875000002,
        "end": 151.46721875,
        "name": "루피",
        "text": "역시 나랑 같은 생각이구나.",
        "corrected_text": "역시 나랑 같은 생각이구나."
    },
    {
        "start": 152.15909375,
        "end": 155.14596875,
        "name": "루피",
        "text": "그럼, 사이즈를 한번 재볼까?",
        "corrected_text": "그럼, 사이즈를 한번 재볼까?"
    },
    {
        "start": 155.55096875,
        "end": 160.54596875,
        "name": "루피",
        "text": "긴장하지 말고 웃어, 오빠. 누가 보면 높이가 잡아먹는 줄 알겠어.",
        "corrected_text": "긴장하지 말고 웃어, 오빠. 누가 보면 호랑이가 잡아먹는 줄 알겠어."
    },
    {
        "start": 165.18659375,
        "end": 166.72221875000002,
        "name": "도라",
        "text": "사이즈 재다가 날 새겠어!",
        "corrected_text": "사이즈 재다가 날 새겠어!"
    },
    {
        "start": 168.81471875,
        "end": 170.68784375,
        "name": "도라",
        "text": "백, 칠십오, 백십, 됐어!",
        "corrected_text": "백, 칠십오, 백십, 됐어!"
    },
    {
        "start": 173.69159375,
        "end": 175.17659375000002,
        "name": "루피",
        "text": "그렇게 대충 하면 안 돼!",
        "corrected_text": "그렇게 대충 하면 안 돼!"
    },
    {
        "start": 175.49721875,
        "end": 179.71596875,
        "name": "루피",
        "text": "루피의 맞춤 제작법은 스물일곱 개의 칫솔을 다 재야 한다고!",
        "corrected_text": "루피의 맞춤 제작법은 스물일곱 개의 치수를 다 재야 한다고!"
    },
    {
        "start": 180.61034375,
        "end": 182.24721875,
        "name": "루피",
        "text": "그러고 있을 시간이 없어!",
        "corrected_text": "그러고 있을 시간이 없어!"
    },
    {
        "start": 182.58471875,
        "end": 186.02721875,
        "name": "도라",
        "text": "내 차 VIP 정비도 열다섯 항목이면 충분했다고!",
        "corrected_text": "내 차 VIP 정비도 열다섯 항목이면 충분했다고!"
    },
    {
        "start": 187.90034375,
        "end": 192.05159375,
        "name": "도라",
        "text": "알지도 못하면서 레오�",
        "corrected_text": "알지도 못하면서!"
    },
    {
        "start": 204.15096875,
        "end": 208.72409375,
        "name": "도라",
        "text": "깔끔한 수트에 금태 안경이면 충분해",
        "corrected_text": "깔끔한 수트에 금테 안경이면 충분해."
    },
    {
        "start": 209.24721875,
        "end": 211.37346875,
        "name": "도라",
        "text": "전문가 느낌, 확실하게 나잖아?",
        "corrected_text": "전문가 느낌, 확실하게 나잖아?"
    },
    {
        "start": 213.01034375,
        "end": 213.53346875000005,
        "name": "도라",
        "text": "안 돼!",
        "corrected_text": "안 돼!"
    },
    {
        "start": 214.09034375,
        "end": 216.16596875,
        "name": "도라",
        "text": "디자이너인 루피 말을 들어야 해!",
        "corrected_text": "디자이너인 루피 말을 들어야 해!"
    },
    {
        "start": 216.53721875,
        "end": 221.86971875,
        "name": "도라",
        "text": "이름만 파티지, 잠입해야 하는 작전인데 저렇게 눈에 띄게 입혀놓고는 어떻게 잠입하라는 거야?",
        "corrected_text": "이름만 파티지, 잠입해야 하는 작전인데 저렇게 눈에 띄게 입혀놓고는 어떻게 잠입하라는 거야?"
    },
    {
        "start": 227.94471875,
        "end": 229.04159375,
        "name": "루피",
        "text": "오빠...",
        "corrected_text": "오빠..."
    },
    {
        "start": 229.21034375,
        "end": 237.31034375,
        "name": "루피",
        "text": "사실 오빠가 다른 여자랑 파티를 가는 건데 루피가 옷을 만들어야 한다는 게 너무, 너무 속상해서 그래",
        "corrected_text": "사실 오빠가 다른 여자랑 파티를 가는 건데 루피가 옷을 만들어야 한다는 게 너무, 너무 속상해서 그래."
    },
    {
        "start": 238.49159375,
        "end": 238.98096875,
        "name": "루피",
        "text": "뭐?",
        "corrected_text": "뭐?"
    },
    {
        "start": 240.11159375000005,
        "end": 245.03909375,
        "name": "루피",
        "text": "오빠는 루피의 공식 남친이잖아. 내 방송 시청자들은 다 아는걸.",
        "corrected_text": "오빠는 루피의 공식 남친이잖아. 내 방송 시청자들은 다 아는걸."
    },
    {
        "start": 245.29221875,
        "end": 246.96284375,
        "name": "루피",
        "text": "그러니까 나도,",
        "corrected_text": "그러니까 나도..."
    },
    {
        "start": 246.96284375,
        "end": 251.80596875,
        "name": "도라",
        "text": "나도 혹시... 고객님, 나랑의 임무가 먼저라는 걸 알아줘.",
        "corrected_text": "나도 혹시… 고객님, 나랑의 임무가 먼저라는 걸 알아줘."
    },
    {
        "start": 254.74221875,
        "end": 259.16346875,
        "name": "루피",
        "text": "정말? 임무 끝나면 루피랑 커플넉 입고 데이트 가주는 거지?",
        "corrected_text": "정말? 임무 끝나면 루피랑 커플룩 입고 데이트 가주는 거지?"
    },
    {
        "start": 259.36596875000004,
        "end": 260.36159375,
        "name": "루피",
        "text": "약속이야?",
        "corrected_text": "약속이야?"
    },
    {
        "start": 264.90096875,
        "end": 268.25909375000003,
        "name": "얀",
        "text": "뭐꼬? 둘이 모여가 뭐하나 했더위만",
        "corrected_text": "뭐꼬? 둘이 모여가 뭐 하나 했더니만."
    },
    {
        "start": 268.73159375,
        "end": 271.26284375,
        "name": "얀",
        "text": "이런",
        "corrected_text": "이런 재밌는 거 하고 있었나?"
    },
    {
        "start": 276.59534375000004,
        "end": 281.69159375000004,
        "name": "얀",
        "text": "재밌는 거 알겠나?",
        "corrected_text": "재밌는 거 하고 있나?"
    },
    {
        "start": 283.17659375,
        "end": 286.58534375,
        "name": "얀",
        "text": "마침 우리 가게에 방어 소재가 세일 중이거든?",
        "corrected_text": "마침 우리 가게에 방탄 소재가 세일 중이거든?"
    },
    {
        "start": 287.59784375000004,
        "end": 289.53846875,
        "name": "얀",
        "text": "우리 신참 옷에 쓸 거면...",
        "corrected_text": "우리 신참 옷에 쓸 거면..."
    },
    {
        "start": 290.50034375,
        "end": 293.08221875000004,
        "name": "얀",
        "text": "포인트 할인에 보너스까지 얹어줄게!",
        "corrected_text": "포인트 할인에 보너스까지 얹어줄게!"
    },
    {
        "start": 293.95971875000004,
        "end": 295.54596875000004,
        "name": "얀",
        "text": "어떤 노? 슬기타재?",
        "corrected_text": "어떤 거? 수트까지?"
    },
    {
        "start": 297.30096875000004,
        "end": 300.30471875,
        "name": "얀",
        "text": "물론, 신참이 결제한다 카면...",
        "corrected_text": "물론, 신참이 결제한다 카면..."
    },
    {
        "start": 300.72659375,
        "end": 303.47721875,
        "name": "얀",
        "text": "다른 결제 방식도 얼마든지 환영이다.",
        "corrected_text": "다른 결제 방식도 얼마든지 환영이다."
    },
    {
        "start": 304.94534375,
        "end": 310.12596875,
        "name": "얀",
        "text": "아휴, 절대로 안 돼! 오빠한테 그런 철판 같은 옷 입히는 거! 난 반대야!",
        "corrected_text": "아휴, 절대로 안 돼! 오빠한테 그런 철판 같은 옷 입히는 거! 난 반대야!"
    },
    {
        "start": 310.95284375,
        "end": 312.92721875,
        "name": "얀",
        "text": "예쁘기만 한 게 다는 아니라!",
        "corrected_text": "예쁘기만 한 게 다는 아이라!"
    },
    {
        "start": 314.02409375,
        "end": 321.43221875,
        "name": "얀",
        "text": "제 기능을 못하는 옷은 상품으로서 가치가 없데이! 신참, 잘 알고 있지? 내가 고른 옷으로도 충분해!",
        "corrected_text": "제 기능을 못하는 옷은 상품으로서 가치가 없데이! 신참, 잘 알고 있지? 내가 고른 옷으로도 충분해!"
    },
    {
        "start": 321.93846875,
        "end": 323.64284375,
        "name": "도라",
        "text": "이러고 있는 시간이 아까워.",
        "corrected_text": "이러고 있는 시간이 아까워."
    },
    {
        "start": 327.43971875,
        "end": 327.81096875000003,
        "name": "도라",
        "text": "오빠는",
        "corrected_text": "오빠는…"
    },
    {
        "start": 327.81096875000003,
        "end": 332.02971875000003,
        "name": "루피",
        "text": "내 편이지! 루피가 디자이너니까 루피의 말을 들어야지!",
        "corrected_text": "내 편이지! 루피가 디자이너니까 루피의 말을 들어야지!"
    },
    {
        "start": 332.62034375,
        "end": 341.78346875,
        "name": "얀",
        "text": "이 가스나가 뭐라카노! 실용성이 제일 중요하다! 이 디자인은 신첨을 위한 최적의 선택이라니까! 이건 나와 고객님의 작전이야!",
        "corrected_text": "이 가스나가 뭐라카노! 실용성이 제일 중요하다! 이 디자인은 신참을 위한 최적의 선택이라니까! 이건 나와 고객님의 작전이야!"
    },
    {
        "start": 342.20534375,
        "end": 343.77471875000003,
        "name": "도라",
        "text": "너희 둘은 빠져.",
        "corrected_text": "너희 둘은 빠져."
    },
    {
        "start": 350.92971875,
        "end": 353.61284375,
        "name": "얀",
        "text": "이것도,",
        "corrected_text": "이것도."
